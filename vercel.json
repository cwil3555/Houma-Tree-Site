{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": null,
  "trailingSlash": true,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/_astro/(.*)",
      "destination": "/$1"
