    {
      "source": "/areas/gray/",
      "destination": "/areas-gray.html"
    },
    {
      "source": "/areas/morgan-city/",
      "destination": "/areas-morgan-city.html"
    },
    {
      "source": "/areas/schriever/",
      "destination": "/areas-schriever.html"
    },
    {
      "source": "/areas/thibodaux/",
      "destination": "/areas-thibodaux.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact.html"
    },
    {
      "source": "/faq/",
      "destination": "/faq.html"
    },
    {
      "source": "/services/emergency-tree-removal/",
      "destination": "/services-emergency-tree-removal.html"
    },
    {
      "source": "/services/land-clearing/",
      "destination": "/services-land-clearing.html"
    },
    {
